DEBUG=true
DJANGO_SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Token fixo de acesso ao painel e a API (Authorization: Bearer <token>)
ACCESS_TOKEN=replace-me
# true: entra no painel sem pedir token (a API continua exigindo o token)
AUTO_LOGIN=true
POSTGRES_DB=github_sync
POSTGRES_USER=github_sync
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
# Repositorios cadastrados automaticamente ao iniciar (owner/name separados por virgula)
GITHUB_REPOSITORIES=
# Mesmo segredo configurado no webhook do GitHub
GITHUB_WEBHOOK_SECRET=
# Opcional: necessario apenas para repositorios privados
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_HTTP_TIMEOUT=10
IGNORE_BRANCHES=tmp/*
